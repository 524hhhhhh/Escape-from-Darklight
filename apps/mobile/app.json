{
  "expo": {
    "name": "escape",
    "slug": "escape",
    "scheme": "escape",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./src/assets/app/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/app/splash.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "splash": {
        "image": "./src/assets/app/splash.png",
        "resizeMode": "cover"
      },
      "bundleIdentifier": "com.johyeju.escape"
    },
    "web": {
      "favicon": "./src/assets/app/icon.png"
    },
    "plugins": ["expo-font"]
  }
}
