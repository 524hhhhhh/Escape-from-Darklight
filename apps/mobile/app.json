{
  "expo": {
    "name": "escape",
    "slug": "escape",
    "scheme": "escape",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./src/assets/app/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/app/splash.png",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "splash": {
        "image": "./src/assets/app/splash.png",
        "resizeMode": "cover"
      },
      "bundleIdentifier": "com.johyeju.escape",
      "infoPlist": {
        "UIHomeIndicatorAutoHidden": true,
        "UIStatusBarHidden": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./src/assets/app/icon.png"
    },
    "plugins": ["expo-font"],
    "extra": {
      "eas": {
        "projectId": "a511f9bd-427b-4de6-bb70-272db71ce4f7"
      }
    }
  }
}
