{
  "name": "escape-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec tsx src/index.ts",
    "build": "tsc -p tsconfig.json && prisma generate",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "express": "^5.1.0",
    "dotenv": "^17.2.2",
    "@prisma/client": "^6.16.2"
  },
  "devDependencies": {
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "nodemon": "^3.1.10",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "typescript": "~5.9.2"
  }
}
