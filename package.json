    "expo": "~54.0.7",
    "expo-asset": "^12.0.8",
    "expo-av": "^16.0.7",
    "expo-dev-client": "~6.0.12",
    "expo-haptics": "^15.0.7",
    "expo-status-bar": "~3.0.8",
    "express": "^5.1.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-game-engine": "^1.2.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@react-native/eslint-config": "^0.81.1",
